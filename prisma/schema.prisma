// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TENANT
  LANDLORD
  ADMIN
}

enum PropertyStatus {
  DRAFT
  SUBMITTED
  ANALYZING
  PENDING_REVIEW
  PUBLISHED
  RENTED
  UNAVAILABLE
  REJECTED
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  phone        String?
  passwordHash String
  role         Role

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  property  Property[]
  savedProperties SavedProperty[]
}

model Property {
  id      String @id @default(cuid())
  ownerId String

  title       String
  description String

  type     String
  city     String
  locality String

  latitude  Float?
  longitude Float?

  rent       Decimal @db.Decimal(12, 2)
  area       Int
  bedrooms   Int
  bathrooms  Int
  furnishing String
  amenities String[] @default([])

  status PropertyStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images PropertyImage[]
  assessments PropertyAssessment[]
  savedBy SavedProperty[]

  @@index([ownerId])
  @@index([city])
  @@index([locality])
  @@index([status])
}

model PropertyImage {
  id         String @id @default(cuid())
  propertyId String

  url        String
  storageKey String?
  sortOrder  Int     @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyAssessment {
  id         String   @id @default(cuid())
  propertyId String

  trustScore Int
  signals    Json

  estimatedRentLow  Decimal @db.Decimal(12, 2)
  estimatedRentMid  Decimal @db.Decimal(12, 2)
  estimatedRentHigh Decimal @db.Decimal(12, 2)

  listedRentOutsideRange Boolean @default(false)
  propertyUpdatedAt DateTime
  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@index([propertyId])
  @@index([trustScore])
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}